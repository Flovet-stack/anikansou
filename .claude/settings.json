{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && { pnpm -s typecheck && pnpm -s test; } 1>&2 || exit 2",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
