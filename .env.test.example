# Copy to .env.test for `pnpm test:db` and `pnpm test:e2e`. Never commit .env.test.
# The tests sign up throwaway users (e2e-…, db-…) in this project. Its Auth
# settings must have email confirmation off.
TEST_SUPABASE_URL=https://your-project-ref.supabase.co
TEST_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
