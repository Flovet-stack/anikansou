# Copy to .env.local and fill in. All three are required: the build fails without them.

# Public origin of the site, with no trailing slash. Production: https://anikansou.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_SUPABASE_PASSWORD=password
# Catalog importer only (pnpm sync:catalog). Server-only: never prefix with NEXT_PUBLIC_.
# Supabase > Connect > Session pooler (port 5432). Also set as the DATABASE_URL repo secret for CI.
# DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres
