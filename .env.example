# Copy to .env.local and fill in. The first three are required: the build fails without them.

# Public origin of the site, with no trailing slash. Production: https://anikansou.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_SUPABASE_PASSWORD=password
# Optional. PostHog analytics stays off without both. Set in Vercel's Production environment only.
# NEXT_PUBLIC_POSTHOG_TOKEN=phc_your_project_token
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Catalog importer only (pnpm sync:catalog). Server-only: never prefix with NEXT_PUBLIC_.
# Supabase > Connect > Session pooler (port 5432). Also set as the DATABASE_URL repo secret for CI.
# DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres
